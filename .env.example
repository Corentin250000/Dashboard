# Copy this file to .env and replace every placeholder with your own value.
# Never commit .env. Choose either classic .env variables or Doppler as described
# in SETUP.md. DOPPLER_TOKEN is the only value needed in .env for the Doppler path.

DOPPLER_TOKEN=

# Server and frontend
PORT=8080
FRONTEND_URL=http://127.0.0.1:8081
VITE_API_URL=http://127.0.0.1:8080
JWT_SECRET=your_random_secret_here

# PostgreSQL (used by Docker Compose; native backend also accepts DB_HOST/DB_PORT)
POSTGRES_DB=dashboard
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=your_database_password_here
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Mailjet email confirmation
API_KEY_MAILJET=your_mailjet_api_key_here
SECRET_KEY_MAILJET=your_mailjet_secret_key_here
MAIL_SENDER_ACCOUNT=verified-sender@example.com

# SNCF Navitia
API_KEY_SNCF=your_sncf_api_key_here

# Oauth 2.0 / OpenID 2.0
API_KEY_STEAM=your_steam_api_key_here
CLIENT_ID_SPOTIFY=your_spotify_client_id_here
CLIENT_SECRET_SPOTIFY=your_spotify_client_secret_here
CLIENT_ID_GITHUB=your_github_client_id_here
CLIENT_SECRET_GITHUB=your_github_client_secret_here
CLIENT_ID_GOOGLE=your_google_client_id_here
CLIENT_SECRET_GOOGLE=your_google_client_secret_here
