{
    "swagger": "2.0",
    "info": {
        "description": "API for the Dashboard services, widgets, and user accounts.",
        "title": "Dashboard API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/": {
            "get": {
                "description": "Return a pointer to the API catalog.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "API root",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.RootResponse"
                        }
                    }
                }
            }
        },
        "/about.json": {
            "get": {
                "description": "Return the available services and widgets for dashboard clients.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Service catalog",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/about.Response"
                        }
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "description": "Authenticate a user with an email and password.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Log in",
                "parameters": [
                    {
                        "description": "Login credentials",
                        "name": "credentials",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/auth.LoginSuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/auth.LoginBadRequestResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/auth.LoginUnauthorizedResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/auth.LoginUnconfirmedResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/auth.LoginServerErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/auth.LoginUnavailableResponse"
                        }
                    }
                }
            }
        },
        "/auth/register": {
            "post": {
                "description": "Create a user account. The account must be confirmed by email before login.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Register",
                "parameters": [
                    {
                        "description": "Registration credentials",
                        "name": "credentials",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth.RegisterRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/auth.RegisterSuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/auth.RegisterBadRequestResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/auth.RegisterConflictResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/auth.RegisterServerErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/auth.RegisterUnavailableResponse"
                        }
                    }
                }
            }
        },
        "/confirm": {
            "get": {
                "description": "Confirm a user account with the token sent by email.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Confirm email",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Email confirmation token",
                        "name": "token",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/auth.ConfirmedResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/auth.ConfirmBadRequestResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/auth.InvalidTokenResponse"
                        }
                    },
                    "410": {
                        "description": "Gone",
                        "schema": {
                            "$ref": "#/definitions/auth.ExpiredResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/auth.ConfirmErrorResponse"
                        }
                    }
                }
            }
        },
        "/confirm/resend": {
            "post": {
                "description": "Send a new email confirmation token for an unconfirmed account.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Resend confirmation email",
                "parameters": [
                    {
                        "description": "Current confirmation token",
                        "name": "token",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth.ResendRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/auth.ResendSuccessResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/auth.ResendBadRequestResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/auth.ResendNotFoundResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/auth.ResendErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/auth.ResendUnavailableResponse"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Check whether the API process is responding.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.HealthResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "about.Param": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "about.Response": {
            "type": "object",
            "properties": {
                "client": {
                    "type": "object",
                    "properties": {
                        "host": {
                            "type": "string"
                        }
                    }
                },
                "server": {
                    "type": "object",
                    "properties": {
                        "current_time": {
                            "type": "integer"
                        },
                        "services": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/about.Service"
                            }
                        }
                    }
                }
            }
        },
        "about.Service": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "widgets": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/about.Widget"
                    }
                }
            }
        },
        "about.Widget": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "params": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/about.Param"
                    }
                }
            }
        },
        "auth.ConfirmBadRequestResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "missing token"
                },
                "status": {
                    "type": "string",
                    "example": "error"
                }
            }
        },
        "auth.ConfirmErrorResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "database error"
                },
                "status": {
                    "type": "string",
                    "example": "error"
                }
            }
        },
        "auth.ConfirmedResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "confirmed"
                }
            }
        },
        "auth.ExpiredResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "expired"
                }
            }
        },
        "auth.InvalidTokenResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "invalid or already used token"
                },
                "status": {
                    "type": "string",
                    "example": "invalid"
                }
            }
        },
        "auth.LoginBadRequestResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Invalid request body"
                },
                "status": {
                    "type": "string",
                    "example": "error"
                }
            }
        },
        "auth.LoginRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "auth.LoginServerErrorResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Server error"
                },
                "status": {
                    "type": "string",
                    "example": "error"
                }
            }
        },
        "auth.LoginSuccessResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Logged in"
                }
            }
        },
        "auth.LoginUnauthorizedResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Invalid credentials"
                },
                "status": {
                    "type": "string",
                    "example": "error"
                }
            }
        },
        "auth.LoginUnavailableResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "database not configured"
                },
                "status": {
                    "type": "string",
                    "example": "error"
                }
            }
        },
        "auth.LoginUnconfirmedResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Account not confirmed, please check your email"
                },
                "status": {
                    "type": "string",
                    "example": "error"
                }
            }
        },
        "auth.RegisterBadRequestResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Invalid fields"
                },
                "status": {
                    "type": "string",
                    "example": "error"
                }
            }
        },
        "auth.RegisterConflictResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "This email is already in use"
                },
                "status": {
                    "type": "string",
                    "example": "error"
                }
            }
        },
        "auth.RegisterRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string",
                    "minLength": 8
                }
            }
        },
        "auth.RegisterServerErrorResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Server error"
                },
                "status": {
                    "type": "string",
                    "example": "error"
                }
            }
        },
        "auth.RegisterSuccessResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Account created, please check your email"
                }
            }
        },
        "auth.RegisterUnavailableResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "database not configured"
                },
                "status": {
                    "type": "string",
                    "example": "error"
                }
            }
        },
        "auth.ResendBadRequestResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "token required"
                },
                "status": {
                    "type": "string",
                    "example": "error"
                }
            }
        },
        "auth.ResendErrorResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "database error"
                },
                "status": {
                    "type": "string",
                    "example": "error"
                }
            }
        },
        "auth.ResendNotFoundResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "unknown token"
                },
                "status": {
                    "type": "string",
                    "example": "invalid"
                }
            }
        },
        "auth.ResendRequest": {
            "type": "object",
            "properties": {
                "token": {
                    "type": "string"
                }
            }
        },
        "auth.ResendSuccessResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "auth.ResendUnavailableResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "database not configured"
                },
                "status": {
                    "type": "string",
                    "example": "error"
                }
            }
        },
        "main.HealthResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "main.RootResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "dashboard API - see GET /about.json"
                }
            }
        }
    }
}